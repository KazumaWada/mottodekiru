
<!--- プロフィール画像、status --->

<!-- プロフィール画像部分とstatus部分で大きさが異なるから、gridではなくflexboxを使用している -->
 <div class="flex items-start gap-4 mb-4"> 
 
 <!-- 🙍🏻‍♂️ profile-pic 外枠薄い線 -->
  <div class="pl-3">
  <%= image_tag "character.jpg", class: "w-[200px] h-[250px] object-cover border-2 border-gray-200 duration-200 rounded-2xl p-3" %>
  
 </div>

 <!-- 👑 user.nameとstatus 外枠薄い線 -->
  <!--name, status-->
  <div class="border-2 border-gray-200 rounded-2xl p-5 max-w-sm bg-white">
    <h3 class="text-lg font-semibold text-gray-800 mb-3">
        <%= @user.name %>'s mottodekiru Stats 🚀
    </h3>

    <div class="">
        
        <div class="text-gray-600 mb-2">
            🏕️ <strong class="ml-1 text-gray-800 font-medium">Joined:</strong> 
            <span class="ml-1"><%= @user.created_at.strftime("%Y-%m") %></span>
        </div>

        <div class="text-gray-600 mb-2">
            <span class="text-xl">📊</span> <strong class="ml-1 text-gray-800 font-medium">Posts:</strong> 
            <span class="ml-1"><%= @posts_count %></span>
        </div>

        <div class="text-gray-600 mb-2">
             <span class="text-xl">🔗</span> <strong class="ml-1 text-gray-800 font-medium">Links:</strong> 
            <span class="ml-1"><%= @links_count %></span>
        </div>

    </div>

    <%= link_to edit_user_path do %>
     <p class="mt-8 text-xs text-gray-500 border-2 border-gray-200 rounded-2xl p-2 bg-white">
         edit profile 🔧
     </p>
    <% end %>
   </div>



</div>


<!--- 参考リンク --->

<!-- 外枠薄い線 -->
<div class="p-3 m-0 rounded-none sm:m-2 sm:rounded-2xl border-2 border-gray-200 duration-200">
<!-- TODO: phoneは非表示にする　-->
<div class="grid grid-cols-1 md:grid-cols-5 gap-1">

 <% count = 0 %>
 <!-- TODO: 動画は10個まで表示する。　-->
 <% @microposts.each do |micropost| %>
 <% break if count >= 5 %>

  
  <% next unless micropost.reference_link.present? %> <!-- ifと似てるけど、ifに入る前に落とす。可読性も兼ねてる。endタグ不要 -->
  <% count += 1 %>
         

         <!-- NOTE: これreturnされてるけど、iframeで囲まれていないよ？どういうこと？-->
         <!-- YouTubeリンク微調節01: YouTubeの時間のparamsがリンクに含まれていたらうまく表示されない。だから含まれていたらカット -->
         <% if micropost.reference_link.include?("&t=") %>
         <!--https://docs.ruby-lang.org/ja/latest/method/String/i/sub.html-->
         <% clean_url = micropost.reference_link.sub(/&t=.*/, '') %>
         <%= clean_url %>
         <% end %>

         <!--YouTubeリンク微調節02: watchがあるとframeが表示されないから、embedで表示。-->
         <% if micropost.reference_link.start_with?("https://www.youtube.com") %>   
            <% embed_url = micropost.reference_link.gsub("watch?v=", "embed/") %>
            <iframe class="w-full" height="190" src="<%= embed_url %>" 
              title="YouTube video player" frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen></iframe>
          <% else %>


          <!-- YouTube以外だったら、普通に文字列で表示 -->   
          <!-- relativeを親要素、absoluteでその上に浮かせる -->
          <div class="relative">
           <div>
            <%= image_tag "default_img.png", class: "h-[190px] w-full" %>
           </div>

           <div class="absolute bottom-0 p-1 text-blue-600 mb-2 uppercase font-extrabold">  
            <!--30文字以上だったら切って、https://も切る。-->
            <% formatted_link =
            micropost.reference_link
            .to_s
            # httpとhttpsをs?でどちらも対応。
            #//を\で文字列に。最後の\は正規表現を閉じる。
            .sub(/^https?:\/\//, "")
            .truncate(20)
            %>
             <a href="<%= micropost.reference_link %>" target="_blank" class="underline hover:text-blue-800">
                <%= formatted_link %>
              </a>
           </div>
          </div><!-- relative -->
          
    <% end %>

<% end %><!-- each.do -->

</div>
</div>

